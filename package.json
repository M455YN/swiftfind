{
  "name": "swift-find",
  "displayName": "SwiftFind",
  "description": "Fast unified search for VS Code with tabs and rich filters.",
  "version": "0.1.3",
  "publisher": "M455YN",
  "author": {
    "name": "Mateusz Afelt"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/M455YN/swiftfind.git"
  },
  "homepage": "https://github.com/M455YN/swiftfind#readme",
  "bugs": {
    "url": "https://github.com/M455YN/swiftfind/issues"
  },
  "icon": "media/icon.png",
  "keywords": [
    "search",
    "fuzzy",
    "ripgrep",
    "findstr",
    "quickpick",
    "solution explorer"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:swiftFind.openReplace",
    "onCommand:swiftFind.open",
    "onView:swiftFind.sidebar",
    "onView:swiftFind.solutionExplorer",
    "onView:swiftFind.tasksExplorer"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "swiftFind.open",
        "title": "%cmd.open%",
        "shortTitle": "%cmd.open.short%"
      },
      {
        "command": "swiftFind.openFullscreen",
        "title": "%cmd.openFullscreen%"
      },
      {
        "command": "swiftFind.openReplace",
        "title": "%cmd.openReplace%"
      },
      {
        "command": "swiftFind.toggleCaseSensitive",
        "title": "%cmd.toggleCase%"
      },
      {
        "command": "swiftFind.toggleRegex",
        "title": "%cmd.toggleRegex%"
      },
      {
        "command": "swiftFind.toggleWholeWord",
        "title": "%cmd.toggleWholeWord%"
      },
      {
        "command": "swiftFind.toggleFuzzy",
        "title": "%cmd.toggleFuzzy%"
      },
      {
        "command": "swiftFind.toggleExcludeGitIgnored",
        "title": "%cmd.toggleExcludeGit%"
      },
      {
        "command": "swiftFind.toggleExcludeSearchIgnored",
        "title": "%cmd.toggleExcludeSearch%"
      },
      {
        "command": "swiftFind.nextTab",
        "title": "%cmd.nextTab%"
      },
      {
        "command": "swiftFind.prevTab",
        "title": "%cmd.prevTab%"
      },
      {
        "command": "swiftFind.focusSidebar",
        "title": "%cmd.focusSidebar%"
      },
      {
        "command": "swiftFind.focusSolutionExplorer",
        "title": "%cmd.focusSolution%"
      },
      {
        "command": "swiftFind.solutionExplorer.refresh",
        "title": "%cmd.solution.refresh%"
      },
      {
        "command": "swiftFind.solutionExplorer.openNode",
        "title": "%cmd.solution.open%"
      },
      {
        "command": "swiftFind.solutionExplorer.searchHere",
        "title": "%cmd.solution.searchHere%"
      },
      {
        "command": "swiftFind.solutionExplorer.replaceHere",
        "title": "%cmd.solution.replaceHere%"
      },
      {
        "command": "swiftFind.solutionExplorer.revealInOS",
        "title": "%cmd.solution.reveal%"
      },
      {
        "command": "swiftFind.solutionExplorer.copyPath",
        "title": "%cmd.solution.copyPath%"
      },
      {
        "command": "swiftFind.tasks.refresh",
        "title": "%cmd.tasks.refresh%"
      },
      {
        "command": "swiftFind.tasks.openTask",
        "title": "%cmd.tasks.open%"
      },
      {
        "command": "swiftFind.tasks.openDefinition",
        "title": "%cmd.tasks.openDefinition%"
      }
    ],
    "keybindings": [
      {
        "command": "swiftFind.open",
        "key": "ctrl+shift+space",
        "when": "editorTextFocus || explorerViewletVisible || inputFocus || terminalFocus"
      },
      {
        "command": "swiftFind.openReplace",
        "key": "ctrl+shift+h",
        "when": "editorTextFocus || explorerViewletVisible || inputFocus || terminalFocus"
      },
      {
        "command": "swiftFind.nextTab",
        "key": "tab",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.prevTab",
        "key": "shift+tab",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.toggleCaseSensitive",
        "key": "alt+c",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.toggleRegex",
        "key": "alt+r",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.toggleWholeWord",
        "key": "alt+w",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.toggleFuzzy",
        "key": "alt+f",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.toggleExcludeGitIgnored",
        "key": "alt+g",
        "when": "inQuickOpen"
      },
      {
        "command": "swiftFind.toggleExcludeSearchIgnored",
        "key": "alt+s",
        "when": "inQuickOpen"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "swiftFind",
          "title": "%views.container.title%",
          "icon": "media/swiftfind.svg"
        }
      ]
    },
    "views": {
      "swiftFind": [
        {
          "id": "swiftFind.solutionExplorer",
          "name": "%views.solution.name%"
        },
        {
          "id": "swiftFind.tasksExplorer",
          "name": "%views.tasks.name%"
        },
        {
          "id": "swiftFind.sidebar",
          "name": "%views.sidebar.name%",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "swiftFind.solutionExplorer.refresh",
          "when": "view == swiftFind.solutionExplorer",
          "group": "navigation"
        },
        {
          "command": "swiftFind.tasks.refresh",
          "when": "view == swiftFind.tasksExplorer",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "swiftFind.solutionExplorer.openNode",
          "when": "view == swiftFind.solutionExplorer && viewItem == swiftFind.fileNode",
          "group": "inline"
        },
        {
          "command": "swiftFind.solutionExplorer.searchHere",
          "when": "view == swiftFind.solutionExplorer",
          "group": "navigation@1"
        },
        {
          "command": "swiftFind.solutionExplorer.replaceHere",
          "when": "view == swiftFind.solutionExplorer",
          "group": "navigation@2"
        },
        {
          "command": "swiftFind.solutionExplorer.revealInOS",
          "when": "view == swiftFind.solutionExplorer",
          "group": "navigation@3"
        },
        {
          "command": "swiftFind.solutionExplorer.copyPath",
          "when": "view == swiftFind.solutionExplorer",
          "group": "navigation@4"
        },
        {
          "command": "swiftFind.tasks.openTask",
          "when": "view == swiftFind.tasksExplorer && viewItem == swiftFind.taskNode",
          "group": "inline"
        },
        {
          "command": "swiftFind.tasks.openDefinition",
          "when": "view == swiftFind.tasksExplorer && viewItem == swiftFind.taskNode",
          "group": "navigation@1"
        }
      ],
      "commandCenter": [
        {
          "command": "swiftFind.open",
          "when": "true"
        },
        {
          "command": "swiftFind.openReplace",
          "when": "true"
        }
      ]
    },
    "configuration": {
      "title": "%cfg.title%",
      "properties": {
        "swiftFind.maxResults": {
          "type": "number",
          "default": 300,
          "minimum": 10,
          "description": "%cfg.maxResults%"
        },
        "swiftFind.caseInsensitive": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.caseInsensitive%"
        },
        "swiftFind.preview": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.preview%"
        }
      }
    }
  },
  "scripts": {
    "lint": "echo \"No linter configured\"",
    "test": "echo \"No tests configured\""
  }
}
